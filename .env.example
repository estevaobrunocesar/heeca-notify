DATABASE_URL="postgresql://heeca:heeca@localhost:5908/heeca_notify?schema=public"
APP_URL="http://localhost:4130"
# Segredo HMAC por produto (o mesmo vai no produto como NOTIFY_SECRET): NOTIFY_SECRET_<PRODUTO EM MAIÚSCULAS>
NOTIFY_SECRET_NAIL=troque-por-32-bytes-hex
# Provedor: console (dev) | meta (Meta Cloud API direto) | twilio (via BSP — ver providers/twilio.ts)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Twilio (só se WHATSAPP_PROVIDER=twilio): TWILIO_WHATSAPP_FROM sem o prefixo "whatsapp:".
# Um TWILIO_CONTENT_SID_<NOME_DO_TEMPLATE> por template (ex.: TWILIO_CONTENT_SID_HEECA_CONFIRMACAO).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Worker dentro do processo (envia a fila a cada 5 s)
NOTIFY_WORKER_INPROCESS=true
# Cota por estabelecimento por mês (0 = sem limite)
NOTIFY_MAX_PER_TENANT_MONTH=0
