// Heeca Notify — serviço central de notificações (WhatsApp) da plataforma.
// Os produtos NÃO falam com a Meta: mandam "template X para este telefone com estas variáveis"
// e recebem de volta status e respostas por callback assinado. Um banco só do Notify.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED // opt-out, telefone inválido, cota
}

/// Uma mensagem pedida por um produto. `providerMessageId` é o id na Meta (ou console_…).
model Message {
  id         String        @id @default(cuid())
  product    String // slug do produto que pediu (nail, lash, dental…)
  tenantId   String // estabelecimento dentro do produto (para cota e relatório)
  tenantName String?
  to         String // E.164
  kind       String // "free" | "template"
  body       String // texto final renderizado (log e provedor console)
  payload    Json // OutboundMessage | TemplateMessage, como o produto mandou
  ref        String? // referência do produto (ex.: id do agendamento)
  callbackUrl String? // para onde devolver status/respostas (assinado com o segredo do produto)

  status            MessageStatus @default(QUEUED)
  providerMessageId String?       @unique
  error             String?
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now())
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([product, tenantId, createdAt])
  @@index([to, createdAt])
}

/// Registro de consentimento por telefone. Opt-out ("PARAR") bloqueia envios de todos os produtos.
model Contact {
  phone     String    @id // E.164
  optedOut  Boolean   @default(false)
  optOutAt  DateTime?
  lastProduct String?
  lastTenantId String?
  updatedAt DateTime  @updatedAt
}

/// Canal próprio de um tenant (número/WABA dele em vez do compartilhado da plataforma). Preenchido
/// quando o produto completa o Embedded Signup do cliente (D11) e chama POST /api/v1/channel; até lá
/// não existe linha e o envio cai no número compartilhado (TWILIO_WHATSAPP_FROM / TWILIO_CONTENT_SID_*).
/// `contentSids` mapeia nome do template (heeca_confirmacao…) -> ContentSid aprovado NA WABA DESTE tenant
/// — cada WABA tem os próprios ContentSids mesmo usando o mesmo texto, então isto não é opcional para
/// templates que o tenant for de fato usar; falta de entrada aqui = erro claro (mesmo comportamento hoje
/// pro número compartilhado), nunca envio silencioso pelo número errado.
model TenantChannel {
  id          String   @id @default(cuid())
  product     String
  tenantId    String
  provider    String   @default("twilio")
  fromPhone   String // E.164, sem "whatsapp:"
  contentSids Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([product, tenantId])
}

/// Eventos recebidos da Meta (respostas e status) e o que foi feito com eles — auditoria.
model InboundEvent {
  id                String   @id @default(cuid())
  type              String // status | button_reply | text
  phone             String?
  providerMessageId String
  payload           Json
  messageId         String? // Message roteada
  product           String?
  delivered         Boolean  @default(false) // callback ao produto respondeu 2xx
  error             String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
